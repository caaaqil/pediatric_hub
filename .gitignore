# ─────────────────────────────────────────────────────────────
# Generated output and secrets.
#
# backend/.env is NOT committed — it holds live credentials. Copy
# backend/.env.example to backend/.env and fill it in, or ask the
# project owner for the completed file. See README.md.
# ─────────────────────────────────────────────────────────────

# Secrets — never commit
.env
.env.local
.env.*.local
!.env.example

# Dependencies — restored by `npm install`
node_modules/

# Flutter build output — restored by `flutter pub get` / `flutter build`
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/android/.gradle/
mobile/android/app/build/
mobile/ios/Pods/
mobile/ios/.symlinks/

# Web build output
frontend/dist/
frontend/build/

# Logs and OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editor state
.idea/
*.iml

# Local backup of the previous git history
.git-old-backup/
