# Copy this file to `.env` and fill in the real values.
#
#   cd backend && cp .env.example .env
#
# The project owner can send you a completed .env — it is deliberately not
# committed, because it holds live credentials.

# ── Database (PostgreSQL) ───────────────────────────────────────────────
# Easiest: create a free Postgres on Render and paste its External Database
# URL here — then local development and the deployed app share one database
# and you do not need Postgres installed locally.
#
# Or run Postgres locally:
#   sudo -u postgres psql -c "CREATE DATABASE pediatric_hub;"
#   DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/pediatric_hub"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pediatric_hub"

# ── Server ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Only needed on some Linux setups — leave it commented out everywhere else.
# On Windows and macOS it pins Prisma to a Linux query engine and breaks
# `prisma generate`, so do NOT uncomment it there.
# PRISMA_CLI_BINARY_TARGETS=debian-openssl-3.0.x

# ── Web client origins (Socket.IO / teleconsultation) ───────────────────
# Comma-separated. Leave blank for local dev; set to your deployed web URL
# in production, e.g. https://pediatric-hub-web.onrender.com
CLIENT_ORIGINS=

# ── Auth ────────────────────────────────────────────────────────────────
# Any long random string works for local development.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# ── AI chatbot (PediaBot) ───────────────────────────────────────────────
# Gemini is primary, Groq is the fallback. Both have free tiers — the app
# still runs without them, the chatbot just replies that it is not configured.
#   Gemini: https://aistudio.google.com/app/apikey
#   Groq:   https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Email (password-reset OTP) ──────────────────────────────────────────
# A Gmail address plus a Google *App Password* (not the account password).
SMTP_EMAIL=you@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password

# ── Payments (WaafiPay / EVC Plus) ──────────────────────────────────────
# The merchant account that RECEIVES payments. These come from
# WaafiPay/Hormuud for a merchant account you own — a plain phone number
# will not work. Leaving them blank means payment attempts will fail.
# WARNING: with real values, POST /payments makes REAL charges.
WAAFIPAY_URL=https://api.waafipay.net/asm
WAAFIPAY_MERCHANT_UID=
WAAFIPAY_API_USER_ID=
WAAFIPAY_API_KEY=
